---
const stats = [
  { n: '250+', l: 'Weddings Planned' },
  { n: '7+', l: 'Years of Excellence' },
  { n: '100%', l: 'Day-of Presence' },
  { n: '∞', l: 'Attention to Detail' },
];
---

<section class="band">
  <img
    src="/images/real-rose-arch-aisle.webp"
    alt="White rose arch aisle installation beneath crystal chandeliers"
  />
  <div class="scrim"></div>
  <div class="wrap band-in">
    {stats.map((s, i) => (
      <div class="b">
        <span class="n">{s.n}</span>
        <span class="l">{s.l}</span>
      </div>
    ))}
  </div>
</section>

<style>
  .band { position: relative; min-height: 340px; display: flex; align-items: center; }

  .band img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .scrim { position: absolute; inset: 0; background: rgba(27, 25, 22, 0.62); }

  .band-in {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    padding-block: 3rem;
  }

  .b { text-align: center; color: var(--ivory); padding: 0 0.5rem; }

  .n {
    display: block;
    font-family: var(--stamp);
    font-size: clamp(2rem, 4.4vw, 2.9rem);
  }

  .l {
    display: block;
    margin-top: 0.4rem;
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(247, 244, 238, 0.75);
  }

  @media (min-width: 700px) {
    .band-in { grid-template-columns: repeat(4, 1fr); }
  }
</style>
