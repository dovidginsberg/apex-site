---
const items = [
  { quote: "Daniel anticipated needs before we even realized them. Every guest felt personally attended to — we were completely present for our wedding because he held everything together flawlessly.", initials: 'SC', name: 'Sarah & Christopher M.', event: 'Private Estate Wedding · The Hamptons' },
  { quote: 'The level of precision was extraordinary. Our 400-person gala ran with such grace that three board members asked if we had doubled our budget. We had simply chosen Apex.', initials: 'JR', name: 'Jonathan R.', event: 'Annual Corporate Gala · Manhattan' },
  { quote: "I've attended events run by the world's best planners. What sets Apex apart is the warmth — guests feel genuinely cared for, not just managed. That's rare and priceless.", initials: 'AV', name: 'Alexandra V.', event: 'Destination Anniversary · Tuscany' },
  { quote: 'Our VIP guests included three heads of state and two Fortune 100 CEOs. Apex handled every concierge need without a single hiccup — the discretion was unmatched.', initials: 'MK', name: 'M. Kellerman', event: 'Private VIP Summit · Upper East Side' },
];
---

<section class="testi" id="testimonials">
  <div class="wrap head reveal">
    <h2>Words from those who <em>trusted us completely.</em></h2>
  </div>
  <div class="wrap grid">
    {items.map((t) => (
      <figure class="card reveal">
        <div class="stars" aria-label="5 out of 5 stars">★★★★★</div>
        <blockquote>&ldquo;{t.quote}&rdquo;</blockquote>
        <figcaption>
          <span class="av">{t.initials}</span>
          <span class="who">
            <span class="name">{t.name}</span>
            <span class="event">{t.event}</span>
          </span>
        </figcaption>
      </figure>
    ))}
  </div>
</section>

<style>
  .testi { padding-block: clamp(3rem, 8vw, 7rem); }
  .head h2 { font-size: clamp(1.9rem, 4vw, 2.7rem); line-height: 1.2; margin-top: 1.2rem; max-width: 26ch; }
  .head em { font-style: italic; color: var(--brass-deep); }

  .grid {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    display: grid;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }

  .card { background: var(--paper); padding: 2.2rem 2rem; margin: 0; display: flex; flex-direction: column; }
  .stars { color: var(--brass); font-size: 0.85rem; letter-spacing: 0.15em; }

  blockquote {
    margin: 1.2rem 0 0;
    font-family: var(--display);
    font-size: 1.05rem;
    line-height: 1.55;
    color: var(--ink);
    flex: 1;
  }

  figcaption { margin-top: 1.6rem; display: flex; align-items: center; gap: 0.9rem; }

  .av {
    width: 40px;
    height: 40px;
    border: 1px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    color: var(--brass-deep);
    flex: none;
  }

  .who { display: flex; flex-direction: column; }
  .name { font-size: 0.9rem; }
  .event { font-size: 0.72rem; color: var(--stone); }

  @media (min-width: 700px) {
    .grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>
