---
import { campaign } from '../data/site';
---

<section class="camp dark section" aria-labelledby="camp-h">
  <div class="wrap camp-head">
    <h2 id="camp-h" class="h-lg reveal">The last inch<br />is ours.</h2>
    <p class="lede reveal">
      A glass nudged into line. A car at the curb before anyone checks the time. A chair drawn
      back at exactly the right moment. Our campaign is about the adjustments nobody asks
      for&nbsp;— and everybody feels.
    </p>
  </div>
  <div class="camp-rail" tabindex="0" aria-label="An Apex Standard campaign posters">
    {campaign.map((c, i) => (
      <figure class={`poster reveal p${i}`}>
        <img src={c.src} alt={c.alt} width="1174" height="1600" loading="lazy" />
      </figure>
    ))}
  </div>
</section>

<style>
  .camp { overflow: hidden; }

  .camp-head { display: grid; gap: 1.6rem; }
  .camp-head .lede { max-width: 46ch; }

  .camp-rail {
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(72vw, 340px);
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-inline: var(--gutter);
    scrollbar-width: none;
  }

  .camp-rail::-webkit-scrollbar { display: none; }

  .poster {
    margin: 0;
    scroll-snap-align: center;
    overflow: hidden;
    background: #000;
  }

  .poster img { width: 100%; aspect-ratio: 1174 / 1600; object-fit: cover; transition: transform 1s var(--ease); }
  .poster:hover img { transform: scale(1.03); }

  @media (min-width: 900px) {
    .camp-head { grid-template-columns: 1fr 1fr; align-items: end; }
    .camp-rail {
      max-width: var(--max);
      margin-inline: auto;
      grid-auto-flow: row;
      grid-template-columns: repeat(4, 1fr);
      gap: 1.4rem;
      overflow: visible;
      align-items: start;
    }
    /* A slight stagger, like prints pinned along a wall. */
    .p1, .p3 { margin-top: 4rem; }
  }
</style>
