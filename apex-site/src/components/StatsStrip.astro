---
const stats = [
  { n: '250+', l: 'Weddings\nPlanned' },
  { n: '7+', l: 'Years of\nExcellence' },
  { n: '100%', l: 'Day-of\nPresence' },
];
---

<div class="wrap">
  <div class="strip">
    {stats.map((s, i) => (
      <div class="cell">
        <span class="num">{s.n}</span>
        <span class="label">
          {s.l.split('\n').map((line) => <span>{line}</span>)}
        </span>
      </div>
    ))}
  </div>
</div>

<style>
  .strip {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border: 1px solid var(--line);
    background: var(--paper);
  }

  .cell {
    padding: 1.8rem 1rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .num {
    font-family: var(--stamp);
    font-size: clamp(2rem, 4.4vw, 2.9rem);
    color: var(--brass-deep);
  }

  .label {
    display: flex;
    flex-direction: column;
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--stone);
    line-height: 1.5;
  }
</style>
