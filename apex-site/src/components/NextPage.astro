---
// A full-width link to the next page, so every page ends somewhere to go.
interface Props { href: string; title: string; image: string }
const { href, title, image } = Astro.props;
---

<a class="next" href={href}>
  <img src={image} alt="" loading="lazy" />
  <span class="next-scrim"></span>
  <span class="wrap next-in">
    <span class="next-label">Next</span>
    <span class="next-title">{title}<span class="next-arrow" aria-hidden="true">→</span></span>
  </span>
</a>

<style>
  .next {
    position: relative;
    display: flex;
    align-items: center;
    min-height: clamp(220px, 32vw, 380px);
    overflow: hidden;
    color: var(--white);
    background: var(--night);
  }

  .next img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.55;
    transform: scale(1.04);
    transition: transform 1.2s var(--ease), opacity 0.6s var(--ease);
  }

  .next:hover img { transform: scale(1); opacity: 0.7; }
  .next-scrim { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(18, 17, 17, 0.75), rgba(18, 17, 17, 0.1)); }

  .next-in { position: relative; width: 100%; display: flex; flex-direction: column; gap: 0.6rem; }

  .next-label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent-on-dark);
  }

  .next-title { font-family: var(--display); font-size: clamp(2.2rem, 6vw, 4.6rem); line-height: 1; }
  .next-arrow { display: inline-block; margin-left: 0.3em; transition: transform 0.5s var(--ease); }
  .next:hover .next-arrow { transform: translateX(10px); }
</style>
