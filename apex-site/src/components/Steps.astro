---
interface Props { title: string; steps: { title: string; text: string }[] }
const { title, steps } = Astro.props;
---

<section class="section dark">
  <div class="wrap">
    <h2 class="h-lg st-h reveal">{title}</h2>
    <ol class="st">
      {steps.map((s, i) => (
        <li class="reveal">
          <span class="st-n">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="h-sm">{s.title}</h3>
          <p class="muted">{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .st-h { max-width: 14ch; }

  .st {
    margin: clamp(2.5rem, 6vw, 4.5rem) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0;
  }

  .st li { position: relative; padding: 1.6rem 0 1.6rem 3.4rem; border-top: 1px solid var(--line-dark); }
  .st-n { position: absolute; left: 0; top: 1.95rem; font-size: 0.8rem; font-weight: 600; letter-spacing: 0.16em; color: var(--accent-on-dark); }
  .st p { margin-top: 0.6rem; max-width: 46ch; }

  @media (min-width: 1000px) {
    .st { grid-template-columns: repeat(3, 1fr); gap: 2.6rem 2rem; }
    .st li { padding: 2rem 0 0; border-top: 1px solid var(--line-dark); }
    .st-n { position: static; display: block; margin-bottom: 1.4rem; }
  }
</style>
