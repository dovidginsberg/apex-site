---
// Teaser only: cards overlap so just a sliver of each page shows, and the
// images are low-resolution so the fine print can't be read.
const pages = [
  { img: '/images/plan/01-cover.webp', label: 'The Plan' },
  { img: '/images/plan/02-inventory.webp', label: 'Inventory' },
  { img: '/images/plan/03-tablescape.webp', label: 'Tablescape' },
  { img: '/images/plan/04-room-design.webp', label: 'Room Design' },
  { img: '/images/plan/07-kiddish-floorplan.webp', label: 'Floor Plans' },
  { img: '/images/plan/06-kiddish-inventory.webp', label: 'Linens' },
  { img: '/images/plan/08-shabbos-floorplan.webp', label: 'Seating' },
  { img: '/images/plan/09-shalosh-seudos-inventory.webp', label: 'Service' },
];
---

<section class="plan" id="every-detail" aria-label="Every detail, planned">
  <div class="pin">
    <div class="wrap head">
      <h2>Every detail,<br /><em>planned.</em></h2>
      <p>
        Before a single chair is placed, every tablescape, linen, and floor plan is mapped out
        in a full operations plan.
      </p>
    </div>
    <div class="stage" aria-hidden="true">
      {pages.map((p, i) => (
        <div class="card" style={`--i:${i};z-index:${pages.length - i}`}>
          <img src={p.img} alt="" loading="lazy" decoding="async" draggable="false" />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .plan { background: var(--paper); border-block: 1px solid var(--line); overflow: hidden; }

  .pin {
    padding-block: clamp(3rem, 7vw, 5.5rem);
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 4vw, 3rem);
  }

  .head h2 { font-size: clamp(2rem, 4vw, 3rem); line-height: 1.15; }
  .head em { font-style: italic; color: var(--brass-deep); }
  .head p { margin-top: 1rem; color: var(--stone); max-width: 58ch; }

  .stage {
    --w: clamp(170px, 24vw, 300px);
    --step: clamp(26px, 6.5vw, 96px);
    position: relative;
    height: calc(var(--w) * 1.294 + 40px);
    margin-inline: auto;
    width: calc(var(--w) + var(--step) * 7);
    max-width: calc(100% - 2 * var(--gutter));
    user-select: none;
    pointer-events: none;
  }

  .card {
    position: absolute;
    top: 20px;
    left: 0;
    width: var(--w);
    aspect-ratio: 612 / 792;
    background: #fff;
    border: 1px solid var(--line);
    box-shadow: -10px 14px 30px rgba(27, 25, 22, 0.16);
    transform-origin: 50% 120%;
    /* Fanned-out resting state; JS animates from a closed stack to this. */
    transform: translateX(calc(var(--step) * var(--i))) rotate(calc((var(--i) - 3.5) * 2deg));
    overflow: hidden;
  }

  .card img { width: 100%; height: 100%; object-fit: cover; }

  @media (max-width: 699px) {
    .stage {
      --w: 150px;
      --step: calc((100vw - 2 * var(--gutter) - var(--w) - 40px) / 7);
      width: calc(var(--w) + var(--step) * 7);
    }
  }

  :global(.plan.is-pinned) .pin { min-height: 100vh; justify-content: center; padding-top: 108px; }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const section = document.querySelector<HTMLElement>('.plan');
  const cards = gsap.utils.toArray<HTMLElement>('.plan .card');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (section && cards.length && !reduced) {
    section.classList.add('is-pinned');
    // Start as a closed stack, then deal the cards out as the page scrolls.
    // Resting x is step * i, so the middle of the fan is where the stack closes up.
    const mid = () => gsap.getProperty(cards[cards.length - 1], 'x') as number / 2;
    gsap.from(cards, {
      x: mid,
      rotate: (i) => (i % 2 ? 1.5 : -1.5),
      ease: 'power2.out',
      stagger: 0.06,
      scrollTrigger: {
        trigger: section,
        start: 'top top',
        end: '+=900',
        pin: section.querySelector('.pin'),
        scrub: 0.6,
      },
    });
  }
</script>
