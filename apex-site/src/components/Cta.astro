---
---

<section class="cta" id="contact">
  <img
    src="/images/real-cherry-blossom-cascade.webp"
    alt="Cascading cherry blossom floral installation lining a reception corridor"
  />
  <div class="scrim"></div>
  <div class="wrap cta-in">
    <h2>Let's create something<br /><em>unforgettable.</em></h2>
    <p class="sub">
      One conversation is all it takes to begin designing the event you've
      always imagined. We'd love to hear your vision.
    </p>
    <div class="actions">
      <a href="tel:+18453766359" class="btn btn-line-inv">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81 19.79 19.79 0 01.34 1.18 2 2 0 012.32 0h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 14.92v2z"></path>
        </svg>
        Call Now
      </a>
      <a href="https://wa.me/18453766359" target="_blank" rel="noopener" class="btn btn-solid-inv">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.96L2.05 22l5.25-1.38a9.9 9.9 0 004.74 1.21h.01c5.46 0 9.9-4.45 9.9-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0012.04 2zm0 18.13h-.01a8.2 8.2 0 01-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.22 8.22 0 01-1.26-4.36c0-4.54 3.7-8.24 8.25-8.24 2.2 0 4.27.86 5.83 2.42a8.17 8.17 0 012.41 5.83c0 4.55-3.7 8.21-8.24 8.21zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.17.25-.64.81-.78.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.24-1.47-1.38-1.72-.15-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.15.16-.25.25-.42.08-.17.04-.31-.02-.44-.06-.12-.56-1.35-.77-1.85-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.44.06-.67.31-.23.25-.87.85-.87 2.08s.89 2.42 1.02 2.59c.12.17 1.75 2.67 4.24 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.08.15-1.18-.06-.1-.23-.16-.48-.29z"></path>
        </svg>
        WhatsApp Us
      </a>
    </div>
  </div>
</section>

<style>
  .cta { position: relative; min-height: 560px; display: flex; align-items: center; }

  .cta img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(27, 25, 22, 0.55), rgba(27, 25, 22, 0.8));
  }

  .cta-in {
    position: relative;
    padding-block: 4rem;
    text-align: center;
    max-width: 640px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .cta-in h2 {
    color: var(--ivory);
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    line-height: 1.1;
    margin-top: 1rem;
  }

  .cta-in h2 em { font-style: italic; color: #d9c99a; }

  .sub { margin-top: 1.4rem; color: rgba(247, 244, 238, 0.8); max-width: 42ch; }

  .actions {
    margin-top: 2.2rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }

  .btn-solid-inv { background: var(--ivory); color: var(--ink); border-color: var(--ivory); }
  .btn-solid-inv:hover { background: transparent; color: var(--ivory); transform: translateY(-2px); }
  .btn-line-inv { color: var(--ivory); border-color: rgba(247, 244, 238, 0.5); }
  .btn-line-inv:hover { background: var(--ivory); color: var(--ink); border-color: var(--ivory); transform: translateY(-2px); }
</style>
