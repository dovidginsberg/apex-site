---
---

<section class="diff">
  <img
    src="/images/real-flower-dome-stage.webp"
    alt="Grand floral dome stage installation with crystal chandelier"
  />
  <div class="scrim"></div>
  <div class="wrap diff-in">
    <h2>
      Juuuust perfect.
    </h2>
    <p class="standard">An Apex Standard.</p>
    <p class="lead">
      We don't just coordinate logistics — we deliver outcomes. Under Daniel
      Pearlman's direction, our team moves through your event with quiet
      expertise, anticipating every need and resolving every detail before
      your guests ever notice.
    </p>
    <a href="#contact" class="btn btn-solid-inv">Start a Conversation</a>
  </div>
</section>

<style>
  .diff { position: relative; min-height: 640px; display: flex; align-items: center; }

  .diff img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(13, 13, 13, 0.72), rgba(13, 13, 13, 0.8));
  }

  .diff-in {
    position: relative;
    padding-block: clamp(3.5rem, 9vw, 6rem);
    max-width: 760px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .diff-in h2 {
    color: var(--ivory);
    font-size: clamp(2.8rem, 7vw, 4.8rem);
    line-height: 1.15;
  }

  .diff-in h2 em { font-style: normal; color: var(--blush); }

  .lead {
    margin-top: 1.8rem;
    color: rgba(255, 255, 255, 0.88);
    font-size: 1.15rem;
    line-height: 1.6;
    max-width: 56ch;
  }

  .standard {
    margin-top: 0.6rem;
    color: var(--ivory);
    font-family: var(--body);
    font-size: 1.5rem;
    letter-spacing: 0.02em;
  }

  .diff-in .btn { margin-top: 2.4rem; }

  .btn-solid-inv { background: var(--ivory); color: var(--ink); border-color: var(--ivory); }
  .btn-solid-inv:hover { background: transparent; color: var(--ivory); transform: translateY(-2px); }
</style>
