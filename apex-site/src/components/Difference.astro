---
---

<section class="diff">
  <img
    src="/images/real-flower-dome-stage.webp"
    alt="Grand floral dome stage installation with crystal chandelier"
  />
  <div class="scrim"></div>
  <div class="wrap diff-in">
    <h2>
      Presence you can <em>feel</em> in the room.
    </h2>
    <p class="lead">
      We don't just coordinate logistics — we create atmosphere. Our team
      moves through your event with quiet expertise, anticipating every need
      and resolving every detail before you ever notice it.
    </p>
    <p class="standard">This is the Apex standard: invisible excellence, felt everywhere.</p>
    <a href="#contact" class="btn btn-solid-inv">Begin Your Journey</a>
  </div>
</section>

<style>
  .diff { position: relative; min-height: 640px; display: flex; align-items: center; }

  .diff img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(27, 25, 22, 0.72), rgba(27, 25, 22, 0.8));
  }

  .diff-in {
    position: relative;
    padding-block: clamp(3.5rem, 9vw, 6rem);
    max-width: 760px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .diff-in h2 {
    color: var(--ivory);
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    line-height: 1.15;
  }

  .diff-in h2 em { font-style: italic; color: #d9c99a; }

  .lead {
    margin-top: 1.8rem;
    color: rgba(247, 244, 238, 0.88);
    font-size: 1.15rem;
    line-height: 1.6;
    max-width: 56ch;
  }

  .standard {
    margin-top: 1rem;
    color: rgba(247, 244, 238, 0.6);
    font-family: var(--display);
    font-style: italic;
    font-size: 1.05rem;
  }

  .diff-in .btn { margin-top: 2.4rem; }

  .btn-solid-inv { background: var(--ivory); color: var(--ink); border-color: var(--ivory); }
  .btn-solid-inv:hover { background: transparent; color: var(--ivory); }
</style>
