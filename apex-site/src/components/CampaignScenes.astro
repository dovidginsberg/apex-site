---
import Juuust from './Juuust.astro';

// The "An Apex Standard" ads, rebuilt as layered scenes. Every layer was cut from the
// original 1174 × 1600 artwork; positions below are in those source pixels.
// Scrolling moves the one thing that isn't quite right into its exact place.
const W = 1174;
const H = 1600;

type Layer = { src: string; x: number; y: number; w: number; h: number; move?: boolean; origin?: string };
type Scene = { id: string; caption: string; alt: string; layers: Layer[]; from: { x?: number; y?: number; rotate?: number } };

const scenes: Scene[] = [
  {
    id: 'arrival',
    caption: 'The car, at the end of the carpet. Before anyone checks the time.',
    alt: 'A chauffeur checks his watch as a limousine glides along a red carpet and stops exactly at its end.',
    from: { x: -560 },
    layers: [
      { src: 'arrival-reflection', x: 328, y: 886, w: 688, h: 113, move: true },
      { src: 'arrival-car', x: 319, y: 747, w: 696, h: 158, move: true },
      { src: 'arrival-chauffeur', x: 0, y: 348, w: 558, h: 1252 },
    ],
  },
  {
    id: 'table',
    caption: 'The chair, exactly where it belongs.',
    alt: 'Seen from above, a hand straightens a velvet chair into its place at a set table.',
    from: { x: 10, y: -125, rotate: 8 },
    layers: [
      { src: 'table-chair', x: 513, y: 590, w: 334, h: 321, move: true, origin: '12% 50%' },
      { src: 'table-edge', x: 430, y: 540, w: 124, h: 420 },
    ],
  },
  {
    id: 'glasses',
    caption: 'The last glass, in line with the rest.',
    alt: 'A hand slides a champagne flute into line with a row of identical glasses.',
    from: { x: -200 },
    layers: [
      { src: 'glasses-reflection', x: 329, y: 1034, w: 165, h: 316, move: true },
      { src: 'glasses-glass', x: 0, y: 414, w: 494, h: 646, move: true },
    ],
  },
];

const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(3)}%`;
const base = '/images/campaign/scenes/';
---

<section class="cs" aria-labelledby="cs-h">
  <div class="wrap cs-intro">
    <h2 id="cs-h" class="h-lg reveal">The last inch<br />is ours.</h2>
    <p class="lede reveal">
      A glass nudged into line. A car at the curb before anyone checks the time. A chair set
      exactly where it belongs. Our campaign is about the adjustments nobody asks for&nbsp;— and
      everybody feels.
    </p>
  </div>

  {scenes.map((s) => (
    <div class={`scene scene-${s.id}`} data-scene data-from={JSON.stringify(s.from)}>
      <div class="scene-pin">
        <div class="scene-backdrop" style={`background-image:url(${base}${s.id}-plate.webp)`} aria-hidden="true"></div>
        <div class="scene-frame" role="img" aria-label={s.alt}>
          <img class="layer plate" src={`${base}${s.id}-plate.webp`} alt="" width={W} height={H} loading="lazy" />
          {s.layers.map((l) => (
            <img
              class={`layer ${l.move ? 'mover' : ''}`}
              src={`${base}${l.src}.webp`}
              alt=""
              width={l.w}
              height={l.h}
              loading="lazy"
              style={`left:${pct(l.x, W)};top:${pct(l.y, H)};width:${pct(l.w, W)};${l.origin ? `transform-origin:${l.origin};` : ''}`}
              data-w={l.w}
            />
          ))}
        </div>
        <div class="scene-copy">
          <p class="scene-cap">{s.caption}</p>
          <p class="scene-line"><Juuust manual /> perfect.</p>
          <p class="standard scene-std">An Apex Standard.</p>
        </div>
      </div>
    </div>
  ))}
</section>

<style>
  .cs { background: var(--night); color: var(--white); }
  .cs-intro { display: grid; gap: 1.6rem; padding-block: clamp(4.5rem, 10vw, 8rem) clamp(2rem, 5vw, 4rem); }
  .cs-intro h2 { color: var(--white); }
  .cs-intro .lede { max-width: 46ch; color: rgba(255, 255, 255, 0.78); }

  .scene-pin {
    position: relative;
    height: 100svh;
    min-height: 560px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* The scene's own backdrop, blurred, fills whatever the artwork doesn't. */
  .scene-backdrop {
    position: absolute;
    inset: -40px;
    background-size: cover;
    background-position: center;
    filter: blur(28px) brightness(0.45);
  }

  .scene-frame {
    position: relative;
    height: 100%;
    aspect-ratio: 1174 / 1600;
    flex: none;
    overflow: hidden;
  }

  .layer { position: absolute; display: block; height: auto; max-width: none; user-select: none; pointer-events: none; }
  .plate { inset: 0; width: 100%; height: 100%; }
  .mover { will-change: transform; }

  .scene-copy {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(var(--header-h) + 1rem);
    padding-inline: var(--gutter);
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.55);
  }

  .scene-cap { font-size: 0.95rem; color: rgba(255, 255, 255, 0.8); max-width: 30ch; }

  .scene-line {
    margin-top: 0.6rem;
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(2.8rem, 9vw, 6.4rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
  }

  .scene-std { margin-top: 0.8rem; color: var(--accent-on-dark); }

  /* Phones: the artwork fills the screen and the words sit at the top. */
  @media (max-width: 899px) {
    .scene-frame { height: 100%; }
    .scene-glasses .scene-copy, .scene-table .scene-copy { top: auto; bottom: 2.4rem; }
    .scene-glasses .scene-pin::after, .scene-table .scene-pin::after,
    .scene-arrival .scene-pin::after {
      content: '';
      position: absolute;
      inset: auto 0 0;
      height: 45%;
      background: linear-gradient(0deg, rgba(0, 0, 0, 0.75), transparent);
      pointer-events: none;
    }
    .scene-arrival .scene-pin::after { inset: 0 0 auto; background: linear-gradient(180deg, rgba(0, 0, 0, 0.7), transparent); }
    .scene-copy { z-index: 2; }
  }

  /* Desktop: the artwork stands full height on the right; the words hold the left. */
  @media (min-width: 900px) {
    .scene-pin { justify-content: flex-end; padding-right: max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter))); }
    .scene-copy {
      top: 50%;
      transform: translateY(-50%);
      right: auto;
      width: min(48vw, 640px);
      padding-left: max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter)));
      padding-right: 0;
    }
    .scene-cap { font-size: 1.05rem; }
  }

  /* Before JS runs (or with reduced motion) the scenes show their finished state. */
  :global(.js) .scene-copy > * { opacity: 0; }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-scene]').forEach((scene) => {
    const from = JSON.parse(scene.dataset.from || '{}') as { x?: number; y?: number; rotate?: number };
    const movers = scene.querySelectorAll<HTMLImageElement>('.mover');
    const copy = scene.querySelectorAll<HTMLElement>('.scene-copy > *');
    const word = scene.querySelector<HTMLElement>('[data-juuust]');
    const play = () => word?.dispatchEvent(new Event('juuust:play'));

    if (reduce) {
      gsap.set(copy, { opacity: 1 });
      play();
      return;
    }

    // Offsets are in source pixels; convert to a share of each layer's own size.
    movers.forEach((m) => {
      const w = Number(m.dataset.w);
      const h = Number(m.getAttribute('height'));
      gsap.set(m, {
        xPercent: ((from.x || 0) / w) * 100,
        yPercent: ((from.y || 0) / h) * 100,
        rotate: from.rotate || 0,
      });
    });
    gsap.set(copy, { opacity: 0, y: 24 });

    gsap
      .timeline({
        defaults: { ease: 'none' },
        scrollTrigger: {
          trigger: scene,
          start: 'top top',
          end: '+=140%',
          pin: scene.querySelector('.scene-pin'),
          scrub: 0.8,
          onUpdate: (st) => {
            if (st.progress > 0.58) play();
          },
        },
      })
      .to(copy[0], { opacity: 1, y: 0, duration: 0.15 }, 0.02)
      .to(movers, { xPercent: 0, yPercent: 0, rotate: 0, duration: 0.55, ease: 'power3.out' }, 0.05)
      .to(copy[1], { opacity: 1, y: 0, duration: 0.15 }, 0.55)
      .to(copy[2], { opacity: 1, y: 0, duration: 0.12 }, 0.72)
      .to({}, { duration: 0.16 });
  });
</script>
