---
---

<section class="hero">
  <div class="wrap hero-in">
    <div class="hero-copy">
      <h1 class="hero-h1">
        Every detail,<br />
        <em>flawlessly</em><br />
        orchestrated.
      </h1>
      <p class="hero-sub">
        Corporate events, galas, and private celebrations — planned and
        managed end to end with precision, discretion, and complete presence.
      </p>
      <p class="hero-led">
        Led by <a href="#daniel">Daniel Pearlman</a>
      </p>
      <div class="hero-actions">
        <a href="#contact" class="btn btn-solid">Begin Planning</a>
        <a href="#gallery" class="btn btn-line">View Our Work</a>
      </div>
    </div>
    <div class="hero-media">
      <img
        src="/images/real-ceremony-aisle.webp"
        alt="Bride walking down a floral-lined aisle toward a lush garden chuppah"
        width="900"
        height="1100"
      />
    </div>
  </div>
</section>

<style>
  .hero { padding-block: clamp(2.5rem, 6vw, 5rem); }
  .hero-in { display: grid; gap: clamp(2.5rem, 5vw, 4rem); }

  .hero-h1 {
    font-size: clamp(2.6rem, 6vw, 4.6rem);
    line-height: 1.05;
    font-weight: 600;
  }

  .hero-h1 em { font-style: normal; color: var(--brass-deep); }

  .hero-sub {
    margin-top: 1.6rem;
    max-width: 34ch;
    color: var(--stone);
    font-size: 1.05rem;
  }

  .hero-led {
    margin-top: 1.4rem;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--brass);
  }

  .hero-led a { color: var(--ink); border-bottom: 1px solid var(--brass); }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2.4rem;
  }

  .hero-media { position: relative; }

  .hero-media img {
    width: 100%;
    height: clamp(320px, 55vw, 620px);
    object-fit: cover;
  }




  @media (min-width: 900px) {
    .hero-in { grid-template-columns: 0.9fr 1.1fr; align-items: center; }
  }
</style>

<script>
  import { gsap } from 'gsap';

  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    gsap.set(['.hero-h1', '.hero-sub', '.hero-led', '.hero-actions', '.hero-media img'], {
      autoAlpha: 0,
    });

    gsap
      .timeline({ defaults: { ease: 'power3.out', duration: 1 } })
      .fromTo('.hero-h1', { y: 30 }, { y: 0, autoAlpha: 1 })
      .fromTo('.hero-sub', { y: 20 }, { y: 0, autoAlpha: 1 }, '-=0.6')
      .fromTo('.hero-led', { y: 20 }, { y: 0, autoAlpha: 1 }, '-=0.6')
      .fromTo('.hero-actions', { y: 20 }, { y: 0, autoAlpha: 1 }, '-=0.6')
      .fromTo(
        '.hero-media img',
        { scale: 1.08, autoAlpha: 0 },
        { scale: 1, autoAlpha: 1, duration: 1.3 },
        '-=0.9'
      );
  }
</script>
