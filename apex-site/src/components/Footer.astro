---
import { nav, site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="foot dark">
  <div class="wrap foot-in">
    <div class="foot-brand">
      <a href="/" aria-label={`${site.name} — home`}>
        <img src="/logo/logo-dp-ivory.png" alt="" width="900" height="352" loading="lazy" />
      </a>
      <p class="muted">Juuuust perfect. An Apex Standard.</p>
    </div>

    <div class="foot-col">
      <p class="ft">Contact</p>
      <ul>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><a href={`tel:${site.phone}`}>{site.phoneDisplay}</a></li>
        <li><a href={site.whatsapp} target="_blank" rel="noopener">WhatsApp</a></li>
      </ul>
    </div>

    <div class="foot-col">
      <p class="ft">Explore</p>
      <ul>
        {nav.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        <li><a href="/contact/">Plan an event</a></li>
      </ul>
    </div>
  </div>

  <div class="wrap">
    <div class="legal">
      <p>&copy; {year} {site.name}</p>
      <p>New York City · Serving clients nationwide</p>
    </div>
  </div>
</footer>

<style>
  .foot { padding-top: clamp(3.5rem, 8vw, 5.5rem); }

  /* One grid, one set of margins: everything starts on the same left edge. */
  .foot-in {
    display: grid;
    gap: 2.8rem;
    padding-bottom: clamp(2.5rem, 6vw, 4rem);
  }

  .foot-brand img { width: 170px; height: auto; }
  .foot-brand p { margin-top: 1.2rem; font-size: 0.95rem; }

  .ft {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
    margin-bottom: 0.9rem;
  }

  .foot-col li + li { margin-top: 0.5rem; }
  .foot-col a { color: rgba(255, 255, 255, 0.85); transition: color 0.3s; }
  .foot-col a:hover { color: var(--white); }

  .legal {
    display: grid;
    gap: 0.4rem;
    padding-block: 1.4rem 1.8rem;
    border-top: 1px solid var(--line-dark);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    color: rgba(255, 255, 255, 0.5);
  }

  @media (min-width: 760px) {
    .foot-in { grid-template-columns: 1.4fr 1fr 1fr; align-items: start; }
    .legal { grid-template-columns: 1fr auto; }
  }
</style>
