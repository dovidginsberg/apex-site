---
const services = [
  {
    img: '/images/real-ceremony-aisle.webp',
    alt: 'Bride walking down a floral-lined aisle toward a garden chuppah',
    n: '01',
    name: 'Wedding Planning',
    desc: 'End-to-end wedding management with vendor relationships, timeline mastery, and flawless day-of execution — every detail handled with grace.',
    cta: 'Begin Your Journey',
  },
  {
    img: '/images/service-champagne.webp',
    alt: 'Bride and groom embracing on the garden path of a luxury estate',
    n: '02',
    name: 'Front of House',
    desc: 'Seamless guest management, reception flow, and hospitality direction. Every arrival feels anticipated, every departure feels warm.',
    cta: 'Explore This Service',
  },
  {
    img: '/images/real-color-stage-lounge.webp',
    alt: 'Custom-designed floral lounge stage with bespoke seating',
    n: '03',
    name: 'Concierge Services',
    desc: 'Bespoke support for VIP guests and travel coordination — the quiet luxury of every need met before it is expressed.',
    cta: 'Discover More',
  },
];
---

<section class="services" id="services">
  <div class="wrap head reveal">
    <h2>Full-spectrum luxury,<br /><em>complete presence.</em></h2>
  </div>
  <div class="wrap grid">
    {services.map((s) => (
      <article class="card reveal">
        <div class="card-media">
          <img src={s.img} alt={s.alt} width="500" height="620" loading="lazy" />
        </div>
        <div class="card-body">
          <span class="card-n">{s.n}</span>
          <h3>{s.name}</h3>
          <p>{s.desc}</p>
          <a href="#contact">{s.cta} →</a>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .services { padding-block: clamp(3rem, 8vw, 7rem); }
  .head h2 { font-size: clamp(2rem, 4vw, 3rem); line-height: 1.15; margin-top: 1.2rem; }
  .head em { font-style: italic; color: var(--brass-deep); }

  .grid {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    display: grid;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }

  .card { background: var(--ivory); display: flex; flex-direction: column; }

  .card-media img {
    width: 100%;
    height: 260px;
    object-fit: cover;
    filter: grayscale(0.15);
  }

  .card-body {
    padding: 2rem 1.8rem 2.2rem;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .card-n {
    font-family: var(--stamp);
    color: var(--stone-light);
    font-size: 1.1rem;
  }

  .card-body h3 { margin-top: 0.6rem; font-size: 1.5rem; }
  .card-body p { margin-top: 0.9rem; color: var(--stone); flex: 1; }

  .card-body a {
    margin-top: 1.6rem;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brass-deep);
  }

  @media (min-width: 700px) {
    .grid { grid-template-columns: repeat(3, 1fr); }
  }
</style>
