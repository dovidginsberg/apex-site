---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';

const shareUrl = `${site.url}/raffle`;
// Caption that goes with the flyer on people's WhatsApp status. Edit freely.
const caption = `🕎 Apex Chanukah Giveaway: $1,000 cash + two events on the house! Free to enter 👉 ${shareUrl.replace('https://', '')}`;
---

<Layout
  title="Chanukah Giveaway"
  description="$1,000 cash and two events on the house. Free to enter. Winners drawn the last night of Chanukah, Dec 11."
  image="/images/chanukah-flyer.jpg"
>
  <section class="rf dark" data-hero>
    <div class="wrap rf-in">
      <div class="rf-copy">
        <p class="pill">Chanukah giveaway · 3 winners</p>
        <ol class="prizes">
          <li><span>1.</span> $1,000 Cash</li>
          <li><span>2.</span> Two Events on the House<sup>*</sup></li>
        </ol>
        <p class="lede">This Chanukah, the gelt is on us. Free to enter. Winners drawn Dec 11.</p>
      </div>

      <div class="card" id="card" data-step="1">
        <ol class="dots" aria-hidden="true"><li>1</li><li>2</li><li>3</li></ol>

        <!-- Step 1: enter -->
        <div class="pane" data-pane="1">
          <h2 class="h-md">Enter</h2>
          <form id="raffle" class="form" novalidate>
            <label class="field">
              <span class="sr">Your name</span>
              <input name="name" autocomplete="name" required maxlength="80" placeholder="Your name" />
            </label>
            <label class="field">
              <span class="sr">WhatsApp number</span>
              <input name="phone" type="tel" autocomplete="tel" inputmode="tel" required placeholder="WhatsApp number" />
            </label>
            <!-- Honeypot for bots; hidden from people and screen readers. -->
            <label class="hp" aria-hidden="true">Website <input name="website" tabindex="-1" autocomplete="off" /></label>
            <p class="err" role="alert" hidden></p>
            <button type="submit" class="btn btn-light">Enter</button>
          </form>
        </div>

        <!-- Step 2: post on status -->
        <div class="pane" data-pane="2" hidden>
          <p class="hi" tabindex="-1"></p>
          <h2 class="h-md">Post it on your status</h2>
          <p class="muted">Tap below, choose <b>WhatsApp</b>, then <b>My status</b>.</p>
          <button type="button" class="btn btn-light" id="post">Post to my status</button>
          <p class="note" id="post-msg" role="status"></p>
          <details class="manual">
            <summary>Doing it by hand?</summary>
            <img src="/images/chanukah-flyer.jpg" alt="Apex Chanukah Giveaway flyer" width="1080" height="1920" loading="lazy" />
            <p class="caption" id="caption">{caption}</p>
            <div class="btn-row">
              <a class="btn btn-ghost-light" href="/images/chanukah-flyer.jpg" download="Apex Chanukah Giveaway.jpg">Download flyer</a>
              <button type="button" class="btn btn-ghost-light" id="copy">Copy caption</button>
            </div>
          </details>
          <button type="button" class="next" data-go="3">I posted it →</button>
        </div>

        <!-- Step 3: upload screenshot -->
        <div class="pane" data-pane="3" hidden>
          <h2 class="h-md">Send your 100 views</h2>
          <p class="muted">After 20 hours, upload a screenshot showing at least 100 views.</p>
          <label class="btn btn-light upload">
            <span id="up-label">Upload screenshot</span>
            <input type="file" id="shot" accept="image/*" />
          </label>
          <p class="err" role="alert" hidden></p>
          <button type="button" class="next" data-go="2">← Back</button>
        </div>

        <!-- Done -->
        <div class="pane" data-pane="4" hidden>
          <p class="big-tick" aria-hidden="true">✓</p>
          <h2 class="h-md" tabindex="-1">You're all set.</h2>
          <p class="muted">We got your screenshot. Winners are drawn the last night of Chanukah, Dec 11. Good luck!</p>
          <button type="button" class="next" data-go="3">Upload a different screenshot</button>
        </div>

        <p class="fine">*Includes full event planning. All expenses covered by winner or host.</p>
        <button type="button" class="reset" id="reset" hidden>Not you? Start over</button>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap explore">
      <h2 class="h-md">While you're here.</h2>
      <p class="muted">Weddings, galas and private celebrations, planned and run by Daniel Pearlman and the Apex team.</p>
      <div class="btn-row">
        <a href="/work/" class="btn btn-dark">See our work</a>
        <a href="/celebrations/" class="btn btn-ghost">Celebrations</a>
        <a href="/corporate/" class="btn btn-ghost">Corporate</a>
        <a href="/" class="btn btn-ghost">Home</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .rf-in {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    padding-top: calc(var(--header-h) + clamp(1.5rem, 5vw, 4rem));
    padding-bottom: clamp(3rem, 7vw, 5rem);
  }
  @media (min-width: 960px) { .rf-in { grid-template-columns: 1fr 1fr; align-items: start; } }

  .pill {
    display: inline-block;
    background: var(--white);
    color: var(--ink);
    border-radius: 999px;
    padding: 0.6em 1.2em 0.45em;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .prizes { list-style: none; margin: 1.2rem 0 0; padding: 0; font-family: var(--display); font-weight: 700; line-height: 1.1; }
  .prizes li { font-size: clamp(1.8rem, 5vw, 3.4rem); }
  .prizes li:first-child { font-size: clamp(2.5rem, 7vw, 4.6rem); }
  .prizes span { color: rgba(255, 255, 255, 0.45); font-size: 0.6em; margin-right: 0.2em; }
  .prizes sup { font-size: 0.45em; }
  .rf .lede { margin-top: 1rem; max-width: 40ch; }

  .card { border: 1px solid var(--line-dark); padding: clamp(1.5rem, 4vw, 2.4rem); }
  .card [hidden] { display: none !important; }

  .dots { list-style: none; display: flex; gap: 0.5rem; margin: 0 0 1.6rem; padding: 0; }
  .dots li {
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    border: 1px solid var(--line-dark);
    display: grid;
    place-items: center;
    font-weight: 700;
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.5);
    transition: all 0.3s var(--ease);
  }
  .card[data-step='1'] .dots li:nth-child(-n + 1),
  .card[data-step='2'] .dots li:nth-child(-n + 2),
  .card[data-step='3'] .dots li:nth-child(-n + 3),
  .card[data-step='4'] .dots li { background: var(--white); border-color: var(--white); color: var(--ink); }

  .pane .h-md { margin-bottom: 0.4rem; }
  .pane .muted { margin: 0 0 1.4rem; }
  .pane > .btn { width: 100%; justify-content: center; text-align: center; }
  .hi { font-weight: 600; margin: 0 0 0.6rem; color: rgba(255, 255, 255, 0.8); }
  .hi:focus, .pane .h-md:focus { outline: none; }

  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .form { display: grid; gap: 1.1rem; margin-top: 1rem; }
  .field input {
    width: 100%;
    border: 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 0;
    background: transparent;
    color: var(--white);
    padding: 0.6rem 0 0.5rem;
    font-size: 1.15rem;
    -webkit-appearance: none;
    appearance: none;
  }
  .field input:focus { outline: none; border-color: var(--white); }
  .field input::placeholder { color: rgba(255, 255, 255, 0.45); }
  .form .btn { margin-top: 0.4rem; width: 100%; justify-content: center; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .err { color: #ffb4b4; font-size: 0.95rem; margin: 0.8rem 0 0; }
  .btn[disabled], .upload.busy { opacity: 0.6; pointer-events: none; }

  .upload { position: relative; cursor: pointer; }
  .upload input { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
  .upload:focus-within { outline: 2px solid var(--white); outline-offset: 3px; }

  .note { min-height: 1.2em; margin: 0.7rem 0 0; font-size: 0.92rem; color: rgba(255, 255, 255, 0.8); }
  .manual { margin-top: 0.4rem; font-size: 0.92rem; }
  .manual summary { cursor: pointer; color: rgba(255, 255, 255, 0.65); }
  .manual img { display: block; width: 55%; max-width: 200px; height: auto; margin: 1rem 0; }
  .caption { border: 1px dashed rgba(255, 255, 255, 0.35); padding: 0.7rem 0.9rem 0.55rem; margin: 0 0 0.9rem; }

  .next, .reset {
    display: block;
    margin-top: 1.6rem;
    background: none;
    border: 0;
    padding: 0;
    color: var(--white);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .reset { margin-top: 0.8rem; font-weight: 400; font-size: 0.85rem; color: rgba(255, 255, 255, 0.5); }
  .big-tick { font-size: 2.6rem; margin: 0 0 0.4rem; }
  .fine { margin: 2rem 0 0; font-size: 0.78rem; color: rgba(255, 255, 255, 0.45); }

  .explore .muted { margin: 1rem 0 1.8rem; max-width: 48ch; }
</style>

<script>
  const STORE = 'apex-raffle';
  const card = document.getElementById('card')!;
  const form = document.getElementById('raffle') as HTMLFormElement;
  const CAPTION = document.getElementById('caption')!.textContent!.trim();

  type Saved = { name: string; phone: string; step: number };
  let me: Saved | null = null;
  try { me = JSON.parse(localStorage.getItem(STORE) || 'null'); } catch {}
  if (me && !me.phone) me = null; // saved by an older version of this page

  const save = () => { try { localStorage.setItem(STORE, JSON.stringify(me)); } catch {} };

  const go = (step: number, focus = true) => {
    card.dataset.step = String(step);
    card.querySelectorAll<HTMLElement>('[data-pane]').forEach((p) => (p.hidden = p.dataset.pane !== String(step)));
    document.getElementById('reset')!.hidden = step === 1;
    if (me) { me.step = step; save(); }
    if (focus) card.querySelector<HTMLElement>(`[data-pane="${step}"] [tabindex="-1"]`)?.focus();
  };
  card.querySelectorAll<HTMLElement>('[data-go]').forEach((b) => b.addEventListener('click', () => go(+b.dataset.go!)));

  const showErr = (pane: string, msg: string) => {
    const e = card.querySelector<HTMLElement>(`[data-pane="${pane}"] .err`)!;
    e.textContent = msg;
    e.hidden = !msg;
  };

  const greet = () => {
    if (me) card.querySelector('.hi')!.textContent = `✓ You're entered, ${me.name.split(' ')[0]}.`;
  };

  // Returning visitors pick up where they left off.
  if (me) { greet(); go(me.step || 2, false); }

  document.getElementById('reset')!.addEventListener('click', () => {
    me = null;
    try { localStorage.removeItem(STORE); } catch {}
    form.reset();
    go(1);
  });

  // ---- Step 1: enter ----
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const d = new FormData(form);
    const name = String(d.get('name') || '').trim();
    const phone = String(d.get('phone') || '').trim();
    if (!name) return showErr('1', 'Please add your name.');
    if (phone.replace(/\D/g, '').length < 8) return showErr('1', 'Please add your WhatsApp number.');
    showErr('1', '');

    const btn = form.querySelector('button')!;
    btn.disabled = true;
    btn.textContent = 'Entering…';
    try {
      const res = await fetch('/api/raffle', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ name, phone, website: d.get('website') }),
      });
      const out = await res.json().catch(() => ({}));
      if (!res.ok || !out.ok) throw new Error(out.error || 'Something went wrong. Please try again.');
      me = { name, phone, step: 2 };
      save();
      greet();
      go(2);
    } catch (x) {
      showErr('1', x instanceof Error && x.message !== 'Failed to fetch' ? x.message : 'Something went wrong. Please try again.');
    } finally {
      btn.disabled = false;
      btn.textContent = 'Enter';
    }
  });

  // ---- Step 2: post flyer + caption to status ----
  const postMsg = document.getElementById('post-msg')!;
  // Fetch the flyer up front: iOS only allows sharing during the tap itself.
  let flyer: File | null = null;
  fetch('/images/chanukah-flyer.jpg')
    .then((r) => r.blob())
    .then((b) => (flyer = new File([b], 'Apex Chanukah Giveaway.jpg', { type: 'image/jpeg' })))
    .catch(() => {});

  const copy = (text: string) => navigator.clipboard?.writeText(text).then(() => true, () => false) ?? Promise.resolve(false);

  document.getElementById('post')!.addEventListener('click', async () => {
    const copied = copy(CAPTION); // started inside the tap, before the share sheet opens
    const data = flyer ? { files: [flyer], text: CAPTION } : null;
    if (data && navigator.canShare?.(data)) {
      try {
        await navigator.share(data);
        postMsg.textContent = (await copied) ? 'Caption copied. Paste it if WhatsApp left it out.' : '';
      } catch {}
      return;
    }
    // Computers and older phones: download the flyer and copy the caption instead.
    const a = document.createElement('a');
    a.href = '/images/chanukah-flyer.jpg';
    a.download = 'Apex Chanukah Giveaway.jpg';
    a.click();
    postMsg.textContent = (await copied)
      ? 'Flyer downloaded and caption copied. Post them on your WhatsApp status.'
      : 'Flyer downloaded. Copy the caption below and post both on your status.';
    (document.querySelector('.manual') as HTMLDetailsElement).open = true;
  });

  const copyBtn = document.getElementById('copy')!;
  copyBtn.addEventListener('click', async () => {
    copyBtn.textContent = (await copy(CAPTION)) ? 'Copied ✓' : 'Copy failed';
    setTimeout(() => (copyBtn.textContent = 'Copy caption'), 2000);
  });

  // ---- Step 3: upload screenshot ----
  // Shrink big phone screenshots before uploading; the view count stays readable.
  const shrink = async (file: File): Promise<Blob> => {
    try {
      const img = await createImageBitmap(file);
      const scale = Math.min(1, 1800 / Math.max(img.width, img.height));
      const c = document.createElement('canvas');
      c.width = Math.round(img.width * scale);
      c.height = Math.round(img.height * scale);
      c.getContext('2d')!.drawImage(img, 0, 0, c.width, c.height);
      const out = await new Promise<Blob | null>((r) => c.toBlob(r, 'image/jpeg', 0.82));
      return out && out.size < file.size ? out : file;
    } catch {
      return file;
    }
  };

  const shot = document.getElementById('shot') as HTMLInputElement;
  const upLabel = document.getElementById('up-label')!;
  shot.addEventListener('change', async () => {
    const file = shot.files?.[0];
    if (!file || !me) return;
    showErr('3', '');
    const box = shot.parentElement!;
    box.classList.add('busy');
    upLabel.textContent = 'Uploading…';
    try {
      const body = new FormData();
      body.append('phone', me.phone);
      body.append('file', await shrink(file), 'screenshot.jpg');
      const res = await fetch('/api/raffle/screenshot', { method: 'POST', body });
      const out = await res.json().catch(() => ({}));
      if (!res.ok || !out.ok) throw new Error(out.error || 'Upload failed. Please try again.');
      go(4);
    } catch (x) {
      showErr('3', x instanceof Error && x.message !== 'Failed to fetch' ? x.message : 'Upload failed. Please try again.');
    } finally {
      box.classList.remove('busy');
      upLabel.textContent = 'Upload screenshot';
      shot.value = '';
    }
  });
</script>
