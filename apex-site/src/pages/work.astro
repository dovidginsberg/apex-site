---
import Layout from '../layouts/Layout.astro';
import NextPage from '../components/NextPage.astro';
import { work } from '../data/site';

const filters = [
  { id: 'all', label: 'All' },
  { id: 'ceremony', label: 'Ceremonies' },
  { id: 'reception', label: 'Receptions' },
  { id: 'film', label: 'Film' },
];
---

<Layout
  title="Work"
  description="Ceremonies, receptions and installations from Apex Events & Concierge — real rooms, photographed and filmed at our events."
  image="/images/real-flower-dome-stage.webp"
>
  <section class="wh dark">
    <div class="wrap wh-in">
      <h1 class="h-xl">The work.</h1>
      <p class="lede">Real rooms from real Apex events. Select any image to see it larger.</p>
      <div class="filters" role="group" aria-label="Filter the work">
        {filters.map((f, i) => (
          <button type="button" class="chip" data-filter={f.id} aria-pressed={i === 0 ? 'true' : 'false'}>{f.label}</button>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap grid" id="work-grid">
      {work.map((w, i) => (
        <button
          type="button"
          class="tile reveal"
          data-cat={w.cat}
          data-type={w.type}
          data-index={i}
          aria-label={`Open: ${w.title}, ${w.meta}`}
        >
          <span class="tile-media" style={`aspect-ratio:${w.w} / ${w.h}`}>
            {w.type === 'video' ? (
              <video src={w.src} poster={w.poster} muted loop playsinline autoplay preload="metadata" aria-hidden="true"></video>
            ) : (
              <img src={w.src} alt={w.alt} loading="lazy" />
            )}
          </span>
          <span class="tile-cap"><span>{w.title}</span><span class="tile-meta">{w.meta}</span></span>
        </button>
      ))}
    </div>
  </section>

  <dialog class="lb" id="lightbox" aria-label="Enlarged view">
    <div class="lb-stage" id="lb-stage"></div>
    <p class="lb-cap" id="lb-cap"></p>
    <button type="button" class="lb-btn lb-close" id="lb-close" aria-label="Close">✕</button>
    <button type="button" class="lb-btn lb-prev" id="lb-prev" aria-label="Previous">←</button>
    <button type="button" class="lb-btn lb-next" id="lb-next" aria-label="Next">→</button>
  </dialog>

  <script type="application/json" id="work-data" set:html={JSON.stringify(work)} />

  <NextPage href="/daniel/" title="Meet Daniel Pearlman" image="/images/hero-daniel-poster.webp" />
</Layout>

<style>
  .wh-in { padding-top: calc(var(--header-h) + clamp(3rem, 8vw, 6rem)); padding-bottom: clamp(2.5rem, 5vw, 4rem); }
  .wh .lede { margin-top: 1.2rem; max-width: 44ch; }

  .filters { margin-top: 2.4rem; display: flex; flex-wrap: wrap; gap: 0.6rem; }

  .chip {
    border: 1px solid var(--line-dark);
    background: transparent;
    color: rgba(255, 255, 255, 0.75);
    padding: 0.85em 1.4em 0.7em;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.3s var(--ease);
  }

  .chip:hover { color: var(--white); border-color: var(--white); }
  .chip[aria-pressed='true'] { background: var(--white); color: var(--ink); border-color: var(--white); }

  .grid { columns: 1; column-gap: 1rem; }
  @media (min-width: 640px) { .grid { columns: 2; } }
  @media (min-width: 1100px) { .grid { columns: 3; } }

  .tile {
    display: block;
    width: 100%;
    margin: 0 0 1rem;
    padding: 0;
    border: 0;
    background: none;
    text-align: left;
    cursor: zoom-in;
    break-inside: avoid;
  }

  .tile[hidden] { display: none; }

  .tile-media { display: block; overflow: hidden; background: #1c1b1b; }
  .tile-media img, .tile-media video { width: 100%; height: 100%; object-fit: cover; transition: transform 1.1s var(--ease); }
  .tile:hover .tile-media img, .tile:hover .tile-media video { transform: scale(1.04); }

  .tile-cap {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.8rem 0 0.4rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .tile-meta { color: var(--mute); font-weight: 400; text-align: right; }

  .lb {
    width: 100vw;
    height: 100vh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(10, 10, 10, 0.97);
    color: var(--white);
  }

  .lb::backdrop { background: rgba(0, 0, 0, 0.6); }
  .lb[open] { display: grid; grid-template-rows: 1fr auto; }

  .lb-stage { display: grid; place-items: center; padding: 4.5rem 1rem 0; min-height: 0; }
  .lb-stage :global(img), .lb-stage :global(video) { max-width: 100%; max-height: 100%; object-fit: contain; }

  .lb-cap { text-align: center; padding: 1.2rem 1rem 1.6rem; font-size: 0.78rem; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(255, 255, 255, 0.75); }

  .lb-btn {
    position: absolute;
    width: 52px;
    height: 52px;
    border: 1px solid var(--line-dark);
    background: rgba(0, 0, 0, 0.3);
    color: var(--white);
    font-size: 1.1rem;
    cursor: pointer;
    transition: background 0.3s, color 0.3s;
  }

  .lb-btn:hover { background: var(--white); color: var(--ink); }
  .lb-close { top: 1rem; right: 1rem; }
  .lb-prev { left: 1rem; top: 50%; transform: translateY(-50%); }
  .lb-next { right: 1rem; top: 50%; transform: translateY(-50%); }
</style>

<script>
  type Item = { type: string; src: string; poster?: string; alt: string; title: string; meta: string; cat: string };
  const items: Item[] = JSON.parse(document.getElementById('work-data')!.textContent || '[]');
  const tiles = Array.from(document.querySelectorAll<HTMLButtonElement>('.tile'));
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.chip'));

  // Filtering
  chips.forEach((chip) =>
    chip.addEventListener('click', () => {
      const f = chip.dataset.filter;
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      tiles.forEach((t) => {
        const show = f === 'all' || (f === 'film' ? t.dataset.type === 'video' : t.dataset.cat === f);
        t.hidden = !show;
        if (show) {
          t.style.opacity = '1';
          t.style.transform = 'none';
        }
      });
    })
  );

  // Lightbox
  const dlg = document.getElementById('lightbox') as HTMLDialogElement;
  const stage = document.getElementById('lb-stage')!;
  const cap = document.getElementById('lb-cap')!;
  let current = 0;

  const visible = () => tiles.filter((t) => !t.hidden).map((t) => Number(t.dataset.index));

  const show = (i: number) => {
    current = i;
    const it = items[i];
    stage.innerHTML = '';
    if (it.type === 'video') {
      const v = document.createElement('video');
      Object.assign(v, { src: it.src, poster: it.poster || '', controls: true, autoplay: true, loop: true, muted: true, playsInline: true });
      v.setAttribute('aria-label', it.alt);
      stage.appendChild(v);
    } else {
      const img = document.createElement('img');
      img.src = it.src;
      img.alt = it.alt;
      stage.appendChild(img);
    }
    cap.textContent = `${it.title} · ${it.meta}`;
  };

  const step = (dir: number) => {
    const list = visible();
    const pos = list.indexOf(current);
    show(list[(pos + dir + list.length) % list.length]);
  };

  tiles.forEach((t) =>
    t.addEventListener('click', () => {
      show(Number(t.dataset.index));
      dlg.showModal();
    })
  );

  document.getElementById('lb-close')!.addEventListener('click', () => dlg.close());
  document.getElementById('lb-prev')!.addEventListener('click', () => step(-1));
  document.getElementById('lb-next')!.addEventListener('click', () => step(1));
  dlg.addEventListener('click', (e) => {
    if (e.target === dlg || e.target === stage) dlg.close();
  });
  dlg.addEventListener('close', () => (stage.innerHTML = ''));
  document.addEventListener('keydown', (e) => {
    if (!dlg.open) return;
    if (e.key === 'ArrowLeft') step(-1);
    if (e.key === 'ArrowRight') step(1);
  });
</script>
